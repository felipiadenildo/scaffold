---
// Formulário de contato sem backend próprio, usando Web3Forms como serviço
// de envio (gratuito, sem necessidade de conta com senha). Para ativar:
// 1. Acesse https://web3forms.com, digite o e-mail de destino, receba a chave.
// 2. Troque WEB3FORMS_ACCESS_KEY abaixo pela chave recebida.
const WEB3FORMS_ACCESS_KEY = 'SUBSTITUA_PELA_SUA_CHAVE_WEB3FORMS';
---

<form id="scaffold-contact-form" class="scaffold-contact-form">
	<input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
	<input type="checkbox" name="botcheck" class="scaffold-hp" tabindex="-1" autocomplete="off" />
	<input type="hidden" name="subject" value="Scaffold: nova mensagem de contato" />

	<label>
		Nome (opcional)
		<input type="text" name="name" autocomplete="name" />
	</label>

	<label>
		E-mail, se quiser resposta
		<input type="email" name="email" autocomplete="email" />
	</label>

	<label>
		Assunto
		<select name="assunto">
			<option value="Sugestão">Sugestão</option>
			<option value="Correção ou erro">Correção ou erro</option>
			<option value="Problema no site">Problema no site</option>
			<option value="Outro">Outro</option>
		</select>
	</label>

	<label>
		Mensagem
		<textarea name="message" rows="6" required></textarea>
	</label>

	<button type="submit">Enviar</button>

	<p class="scaffold-form-status" role="status" aria-live="polite"></p>
</form>

<style>
	.scaffold-contact-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 32rem;
		margin-block: 1.5rem;
	}
	.scaffold-hp {
		position: absolute;
		left: -9999px;
	}
	.scaffold-contact-form label {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-gray-2);
	}
	.scaffold-contact-form input[type='text'],
	.scaffold-contact-form input[type='email'],
	.scaffold-contact-form select,
	.scaffold-contact-form textarea {
		font: inherit;
		font-weight: 400;
		padding: 0.6rem 0.75rem;
		border-radius: 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		background-color: var(--sl-color-black);
		color: var(--sl-color-white);
	}
	.scaffold-contact-form input:focus-visible,
	.scaffold-contact-form select:focus-visible,
	.scaffold-contact-form textarea:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 1px;
	}
	.scaffold-contact-form button {
		align-self: flex-start;
		font: inherit;
		font-weight: 700;
		padding: 0.65rem 1.4rem;
		border-radius: 999px;
		border: none;
		background-color: var(--sl-color-accent);
		color: var(--sl-color-white);
		cursor: pointer;
		transition: opacity 0.15s ease;
	}
	.scaffold-contact-form button:hover {
		opacity: 0.9;
	}
	.scaffold-contact-form button:disabled {
		opacity: 0.6;
		cursor: default;
	}
	.scaffold-form-status {
		margin: 0;
		font-size: var(--sl-text-sm);
		min-height: 1.2em;
	}
	.scaffold-form-status[data-state='success'] {
		color: var(--sl-color-green);
	}
	.scaffold-form-status[data-state='error'] {
		color: var(--sl-color-red);
	}
</style>

<script>
	function initContactForm() {
		const form = document.getElementById('scaffold-contact-form') as HTMLFormElement | null;
		if (!form || form.dataset.bound) return;
		form.dataset.bound = 'true';

		const status = form.querySelector('.scaffold-form-status') as HTMLParagraphElement | null;
		const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!status || !button) return;

			const key = (form.querySelector('input[name="access_key"]') as HTMLInputElement)?.value;
			if (!key || key.startsWith('SUBSTITUA')) {
				status.dataset.state = 'error';
				status.textContent =
					'Formulário ainda não configurado: falta a chave do Web3Forms (ver comentário no componente).';
				return;
			}

			button.disabled = true;
			status.dataset.state = '';
			status.textContent = 'Enviando...';

			try {
				const response = await fetch('https://api.web3forms.com/submit', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify(Object.fromEntries(new FormData(form))),
				});
				const result = await response.json();

				if (result.success) {
					status.dataset.state = 'success';
					status.textContent = 'Mensagem enviada. Obrigado pelo retorno.';
					form.reset();
				} else {
					status.dataset.state = 'error';
					status.textContent = 'Não foi possível enviar agora. Tente de novo em instantes.';
				}
			} catch {
				status.dataset.state = 'error';
				status.textContent = 'Falha de conexão. Tente de novo em instantes.';
			} finally {
				button.disabled = false;
			}
		});
	}

	initContactForm();
	document.addEventListener('astro:page-load', initContactForm);
</script>
