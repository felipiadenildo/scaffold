---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
	{ href: `${base}/sobre/`, label: 'Sobre este material' },
	{ href: `${base}/como-citar/`, label: 'Como citar' },
	{ href: `${base}/licenca/`, label: 'Licença' },
	{ href: `${base}/acessibilidade/`, label: 'Acessibilidade' },
	{ href: `${base}/contato/`, label: 'Contato' },
	{ href: `${base}/changelog/`, label: 'Changelog' },
];
---

<footer class="scaffold-site-footer">
	<nav class="scaffold-footer-links" aria-label="Links institucionais">
		<ul>
			{
				links.map((link) => (
					<li>
						<a href={link.href}>{link.label}</a>
					</li>
				))
			}
		</ul>
	</nav>
	<div class="scaffold-footer-bottom">
		<p class="scaffold-footer-note">
			Scaffold é um material de referência, não um substituto de diagnóstico ou tratamento.
		</p>
		<p class="scaffold-footer-copyright">&copy; {new Date().getFullYear()} Scaffold</p>
	</div>
</footer>

<style>
	.scaffold-site-footer {
		/* As duas linhas verticais (sidebar esquerda e índice à direita)
		   são fixas e correm a altura inteira da viewport de propósito —
		   são divisórias permanentes de página, não só do artigo. O
		   rodapé mora no espaço entre as duas, não preso à largura mais
		   estreita do texto: padding-inline dá o respiro da esquerda
		   (mesmo valor do artigo), margin-inline-end reserva à direita
		   exatamente a mesma largura que o Starlight reserva pro índice
		   (replicando a fórmula de TwoColumnContent, mesmo breakpoint de
		   72rem), então a borda do rodapé encontra a linha da direita
		   sem invadi-la nem sobrar espaço vazio entre as duas. */
		border-top: 1px solid var(--scaffold-border);
		padding-block: 1.5rem;
		padding-inline: var(--sl-content-pad-x);
		margin-top: 3rem;
	}

	@media (min-width: 72rem) {
		.scaffold-site-footer {
			margin-inline-end: max(
				var(--sl-sidebar-width),
				calc(var(--sl-sidebar-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2)
			);
		}
	}

	.scaffold-footer-links ul {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin: 0 0 1rem;
		padding: 0;
	}

	.scaffold-footer-links a {
		font-size: var(--sl-text-sm);
		color: var(--scaffold-ink-soft);
		text-decoration: none;
	}

	.scaffold-footer-links a:hover,
	.scaffold-footer-links a:focus-visible {
		color: var(--scaffold-accent);
		text-decoration: underline;
	}

	.scaffold-footer-bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		border-top: 1px solid var(--scaffold-border);
		padding-top: 1rem;
	}

	.scaffold-footer-note,
	.scaffold-footer-copyright {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--scaffold-ink-soft);
		max-width: 60ch;
	}
</style>