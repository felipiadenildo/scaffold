---
// Rodapé institucional do site inteiro, uma vez por página. Alinhado
// com a largura de leitura (--sl-content-width), não com a largura
// total da tela: tanto a sidebar esquerda quanto o índice "Nesta
// página" à direita são `position: fixed`, ocupando a altura inteira
// da viewport pra sempre, não só até onde o conteúdo termina. Um
// rodapé de largura total ficaria atrás de uma delas ou das duas,
// dependendo da largura da tela. Alinhado à coluna de leitura, ele
// nunca entra nessas duas faixas — e mantém o mesmo ritmo do resto
// da página. Ver PageFrame.astro para onde ele entra na árvore.
// import.meta.env.BASE_URL (não um "/" cru): o site é publicado sob
// /scaffold no GitHub Pages, então um href absoluto sem o prefixo
// aponta pro domínio errado e cai em 404. BASE_URL vem SEM barra
// final ("/scaffold", não "/scaffold/"), então a barra entre base e
// caminho precisa ser explícita — concatenar direto gerava
// "/scaffoldsobre/" (uma palavra só, 404), que passou despercebido
// numa verificação anterior por testar a URL esperada em vez do
// href de verdade renderizado na página.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
	{ href: `${base}/sobre/`, label: 'Sobre este material' },
	{ href: `${base}/como-citar/`, label: 'Como citar' },
	{ href: `${base}/licenca/`, label: 'Licença' },
	{ href: `${base}/acessibilidade/`, label: 'Acessibilidade' },
	{ href: `${base}/contato/`, label: 'Contato' },
	{ href: `${base}/changelog/`, label: 'Changelog' },
];
---

<footer class="scaffold-site-footer">
	<nav class="scaffold-footer-links" aria-label="Links institucionais">
		<ul>
			{
				links.map((link) => (
					<li>
						<a href={link.href}>{link.label}</a>
					</li>
				))
			}
		</ul>
	</nav>
	<div class="scaffold-footer-bottom">
		<p class="scaffold-footer-note">
			Scaffold é um material de referência, não um substituto de diagnóstico ou tratamento.
		</p>
		<p class="scaffold-footer-copyright">&copy; {new Date().getFullYear()} Scaffold</p>
	</div>
</footer>

<style>
	.scaffold-site-footer {
		/* Mesma margem lateral que o artigo usa (--sl-content-pad-x),
		   pra não colar nas linhas da sidebar esquerda nem chegar perto
		   da faixa do índice à direita — mesmo respiro do texto, não
		   flush com a borda do miolo de conteúdo. */
		max-width: var(--sl-content-width);
		border-top: 1px solid var(--scaffold-border);
		padding-block: 1.5rem;
		padding-inline: var(--sl-content-pad-x);
		margin-top: 3rem;
	}

	.scaffold-footer-links ul {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin: 0 0 1rem;
		padding: 0;
	}

	.scaffold-footer-links a {
		font-size: var(--sl-text-sm);
		color: var(--scaffold-ink-soft);
		text-decoration: none;
	}

	.scaffold-footer-links a:hover,
	.scaffold-footer-links a:focus-visible {
		color: var(--scaffold-accent);
		text-decoration: underline;
	}

	.scaffold-footer-bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		border-top: 1px solid var(--scaffold-border);
		padding-top: 1rem;
	}

	.scaffold-footer-note,
	.scaffold-footer-copyright {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--scaffold-ink-soft);
		max-width: 60ch;
	}
</style>
