---
// O Starlight não expõe um slot de "rodapé do site inteiro" — só o
// PageFrame (cabeçalho + sidebar + conteúdo) e o Footer por página
// (paginação/edição/data). O rodapé institucional (links, aviso
// legal, copyright) é o mesmo em toda página, então entra aqui.
//
// A sidebar do Starlight é `position: fixed`, ocupando a altura
// inteira da viewport, independente do scroll (não é um elemento de
// fluxo normal que "termina" no fim do conteúdo). Por isso o rodapé
// não pode ser irmão de <Default>, fora de ".main-frame" — ele ficaria
// atrás da faixa fixa da sidebar. Ele precisa entrar DENTRO do slot
// padrão (default), junto do conteúdo da página, para herdar o
// deslocamento (`padding-inline-start`) que o ".main-frame" já aplica
// para não ficar sob a sidebar. Isso também é mais correto para a
// largura: full-bleed teria que empurrar a sidebar de lado, e ela é
// permanente por design — o rodapé ocupa a largura inteira da área de
// conteúdo, que é o que realmente faz sentido aqui.
import Default from '@astrojs/starlight/components/PageFrame.astro';
import type { Props } from '@astrojs/starlight/props';
import SiteFooter from './SiteFooter.astro';

const props = Astro.props as Props;
---

<Default {...props}>
	<slot name="header" slot="header" />
	<slot name="sidebar" slot="sidebar" />
	<slot />
	<SiteFooter />
</Default>
