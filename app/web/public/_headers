# Cabeçalhos do Cloudflare (Workers Static Assets).
# O service worker e o manifesto nunca podem ficar presos em cache — é por eles que o app descobre
# que existe versão nova (e mostra o "Nova versão · Atualizar").
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
# Arquivos com hash no nome mudam de nome a cada versão: podem ficar em cache pra sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
